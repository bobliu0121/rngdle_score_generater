# 编译产物
*.exe

# 运行时生成的结果页（每次运行覆盖）
rngdle_result.html

# 官网取证 / 批量计算中间产物
_verify/

# 百分位数据文件（已内联进 rngdle_score.cpp，无需提交）
*.dat

# 全量 EP 索引缓存（服务端用 exe --batch 生成，可随时重建）
ep_index.bin
ep_index.bin.*

# 抽取配置：本地运行时文件（配置页每次保存都会重写），仓库里只保留模板 config.example.json
config.json

# Python 缓存
__pycache__/

# 编译日志等临时文件
build_err.txt

# 开发期测试截图（本地保留，不提交）
_shots/

# 免安装发布包产物（由 make_release.py 生成）
release/
RNGdle_standalone_*.zip

# 全量 EP 排名（26MB 级，本地查看用，不入库）
RNGdle_全量EP排名.xlsx
RNGdle_全量EP排名.md

# 徽章图鉴（供本地 Excel 查看，不入库；md 版入库存档）
RNGdle_徽章图鉴.xlsx

# 徽章数据提取临时文件
_badge_extract.py
_badge_gen_*.py
_badges_raw.json
_emoji.json

